# @spec DEPLOY-BE-023
FROM public.ecr.aws/lambda/python:3.12

WORKDIR ${LAMBDA_TASK_ROOT}

# Only what inference imports. xgboost-cpu is the CPU-only build of XGBoost:
# Lambda has no GPU, and the default wheel's GPU library and NCCL dependency add
# several hundred MB that a cold container pulls from ECR. scikit-learn, pandas
# and requests are training/UI dependencies; xgboost imports scikit-learn and
# pandas whenever they are installed, lengthening the Lambda init phase.
RUN pip install --no-cache-dir \
    xgboost-cpu==3.2.0 \
    numpy==2.4.4 \
    pydantic==2.13.4 \
    boto3==1.43.7

COPY src/genomic_ancestry_pipeline/ ./genomic_ancestry_pipeline/

CMD ["genomic_ancestry_pipeline.deployment.lambda_handler"]
